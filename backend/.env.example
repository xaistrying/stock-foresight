# Copy to backend/.env. Never commit the real file.

# Debate analyst. Optional: without it the dashboard shows the rule-based AI Insight panel.
# claude_cli runs through the `claude` command with your Claude login and needs no API key.
DEBATE_LLM_PROVIDER=claude_cli
DEBATE_LLM_MODEL=sonnet           # claude_cli: haiku | sonnet | opus
DEBATE_LLM_EFFORT=xhigh           # claude_cli only: low | medium | high | xhigh | max

# API providers only (leave these out for claude_cli):
# OPENAI_API_KEY=<your-openai-key>
# ANTHROPIC_API_KEY=<your-anthropic-key>
